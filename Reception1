<video
    id="videoPlayer"
    autoplay
    muted
    playsinline
    preload="auto">
</video>

<script>
const owner = "itallied143";
const repo = "YOUR-REPOSITORY";
const folder = "Video";

const player = document.getElementById("videoPlayer");

async function loadVideos() {
    const response = await fetch(
        `https://api.github.com/repos/${owner}/${repo}/contents/${folder}`
    );

    const files = await response.json();

    const videos = files
        .filter(file => file.name.toLowerCase().endsWith(".mp4"))
        .sort((a, b) => a.name.localeCompare(b.name))
        .map(file => file.download_url);

    if (videos.length === 0) return;

    let currentVideo = 0;

    function playVideo() {
        player.src = videos[currentVideo];
        player.play().catch(error => {
            console.log("Autoplay blocked:", error);
        });
    }

    // When one video finishes, play the next
    player.addEventListener("ended", () => {
        currentVideo++;

        // After last video, go back to first
        if (currentVideo >= videos.length) {
            currentVideo = 0;
        }

        playVideo();
    });

    playVideo();
}

loadVideos();
</script>
